{
  "installCommand": "npm install --prefix smart-timetable-saas/apps/web",
  "buildCommand": "npm run build --prefix smart-timetable-saas/apps/web",
  "outputDirectory": "smart-timetable-saas/apps/web/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
